<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weather API</title>
    <link rel="stylesheet" href="/styles/style.css" />
  </head>
  <body>
    <div class="container">
      <div  class="current">
        <div class="search-after">
          <form action="/weather" method="GET">
            <input type="text" name="location" placeholder="Search" required />
            <button type="submit">
              <img src="/images/search.png" alt="Search Icon" height="27" />
            </button>
          </form>
        </div>

        <div class="temp-details">
          <div class="temp">
            <h1><%= location %></h1>
            <h1><%= currTemp %> &deg;C</h1>
          </div>
          <div class="icon">
            <%- getCurrentIcon(isDay, currWeatherCode) %>
          </div>
        </div>
      </div>

      <div class="forecast">
        <div class="six">
          <p>6h</p>
          <div class="icon">
            <%- getHourlyIcon(hourly, 0) %>
          </div>
          <p><%= hourly[0].hourlyTemp %> &deg;C</p>
        </div>

        <div class="nine">
          <p>9h</p>
          <div class="icon">
            <%- getHourlyIcon(hourly, 1) %>
          </div>
          <p><%= hourly[1].hourlyTemp %> &deg;C</p>
        </div>

        <div class="twelve">
          <p>12h</p>
          <div class="icon">
            <%- getHourlyIcon(hourly, 2) %>
          </div>
          <p><%= hourly[2].hourlyTemp %> &deg;C</p>
        </div>

        <div class="fifteen">
          <p>15hr</p>
          <div class="icon">
            <%- getHourlyIcon(hourly, 3) %>
          </div>
          <p><%= hourly[3].hourlyTemp %> &deg;C</p>
        </div>

        <div class="eighteen">
          <p>18hr</p>
          <div class="icon">
            <%- getHourlyIcon(hourly, 4) %>
          </div>
          <p><%= hourly[4].hourlyTemp %> &deg;C</p>
        </div>

        <div class="twenty-one">
          <p>21hr</p>
          <div class="icon">
            <%- getHourlyIcon(hourly, 5) %>
          </div>
          <p><%= hourly[5].hourlyTemp %> &deg;C</p>
        </div>
      </div>

      <div class="details">
        <div class="sunrise">
          <div class="details-icon">
            <img src="/images/sunrise (1).png" alt="Sunrise" height="60" />
          </div>

          <div class="content">
            <h3>Sunrise</h3>
            <p><%= todaySunrise.slice(11) %></p>
          </div>
        </div>
        <div class="sunset">
          <div class="details-icon">
            <img src="/images/sunset (1).png" alt="Sunset" height="60" />
          </div>

          <div class="content">
            <h3>Sunset</h3>
            <p><%= todaySunset.slice(11) %></p>
          </div>
        </div>
        <div class="humidity">
          <div class="details-icon">
            <img src="/images/humidity (1).png" alt="Humidity" height="50" />
          </div>

          <div class="content">
            <h3>Humidity</h3>
            <p><%= currHumidity %> %</p>
          </div>
        </div>
        <div class="rain">
          <div class="details-icon">
            <img src="/images/heavy-rain.png" alt="Rain" height="50" />
          </div>

          <div class="content">
            <h3>Rain</h3>
            <p><%= precipitation %> mm</p>
          </div>
        </div>
      </div>

      <div class="week-forecast">
        <div class="search">
          <form action="/weather" method="GET">
            <input type="text" name="location" placeholder="Search" required />
            <button type="submit">
              <img src="/images/search.png" alt="Search Icon" height="27" />
            </button>
          </form>
        </div>

        <div class="content-list">
          <div class="content">
            <p class="date" data-date="<%= daily[0].date %>">
              <%= daily[0].date %>
            </p>
            <div class="icon">
              <%- getWeeklyIcon(daily, 0)  %>
            </div>
            <p><%= daily[0].minTemp %> / <%= daily[0].maxTemp %></p>
          </div>
  
          <div class="content">
            <p class="date" data-date="<%= daily[1].date %>">
              <%= daily[1].date %>
            </p>
            <div class="icon">
              <%- getWeeklyIcon(daily, 1)  %>
            </div>
            <p><%= daily[1].minTemp %> / <%= daily[1].maxTemp %></p>
          </div>
  
          <div class="content">
            <p class="date" data-date="<%= daily[2].date %>">
              <%= daily[2].date %>
            </p>
            <div class="icon">
              <%- getWeeklyIcon(daily, 2)  %>
            </div>
            <p><%= daily[2].minTemp %> / <%= daily[2].maxTemp %></p>
          </div>
  
          <div class="content">
            <p class="date" data-date="<%= daily[3].date %>">
              <%= daily[3].date %>
            </p>
            <div class="icon">
              <%- getWeeklyIcon(daily, 3)  %>
            </div>
            <p><%= daily[3].minTemp %> / <%= daily[3].maxTemp %></p>
          </div>
  
          <div class="content">
            <p class="date" data-date="<%= daily[4].date %>">
              <%= daily[4].date %>
            </p>
            <div class="icon">
              <%- getWeeklyIcon(daily, 4)  %>
            </div>
            <p><%= daily[4].minTemp %> / <%= daily[4].maxTemp %></p>
          </div>
  
          <div class="content last">
            <p class="date" data-date="<%= daily[5].date %>">
              <%= daily[5].date %>
            </p>
            <div class="icon">
              <%- getWeeklyIcon(daily, 5)  %>
            </div>
            <p><%= daily[5].minTemp %> / <%= daily[5].maxTemp %></p>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const dates = document.querySelectorAll(".date");

        dates.forEach((date) => {
          const dateStr = date.getAttribute("data-date");
          const newDate = new Date(dateStr);
          const options = { weekday: "long" };
          const dayName = newDate.toLocaleDateString("en-US", options);

          date.innerHTML = `${dayName}`;
        });
      });
    </script>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  </body>
</html>
